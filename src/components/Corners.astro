---
import { Image } from "astro:assets";
import headshot from "../assets/headshot.jpg";
---

<a href="/" aria-label="Noel John, home" class="avatar-link">
  <Image
    src={headshot}
    alt="Noel John"
    widths={[40, 80, 120]}
    sizes="40px"
    loading="eager"
    class="avatar"
  />
</a>

<!-- The icon and label name the mode the button switches to. -->
<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to light mode">
  <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a7 7 0 0 0 11 11Z"></path>
  </svg>
  <span class="toggle-label">Light</span>
</button>

<script>
  // Dark is the default. The button switches to light and remembers the choice.
  const btn = document.getElementById("theme-toggle");
  const label = btn?.querySelector(".toggle-label");
  const root = document.documentElement;
  const render = () => {
    const light = root.dataset.theme === "light";
    btn?.setAttribute("aria-label", light ? "Switch to dark mode" : "Switch to light mode");
    if (label) label.textContent = light ? "Dark" : "Light";
    for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
      meta.setAttribute("content", light ? "#eef0f5" : "#121731");
    }
  };
  render();
  btn?.addEventListener("click", () => {
    const light = root.dataset.theme !== "light";
    if (light) root.dataset.theme = "light";
    else delete root.dataset.theme;
    try {
      localStorage.setItem("theme", light ? "light" : "dark");
    } catch {
      // Storage can be blocked; the switch still works for this visit.
    }
    render();
  });
</script>
